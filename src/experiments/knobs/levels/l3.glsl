// Уровень 3 «Мост и люк»: слияние (A) строит мост на среднюю плиту (как в уровне 1), но заодно заращивает
// люк у стены; под люком — жёлоб к маяку, который надо выпрямить скручиванием (B).
// Решение: мост → шарик докатился до стены → ослабить слияние (люк открывается под шариком).
float level3(vec3 p, vec2 knob) {
  float k = 2.4 * knob.x;
  float K = (knob.y - 0.5) * 2.0;
  float a = slab(p, vec3(-2.35, 0.45, 0.0), vec3(1.0, 0.12, 0.45), -0.13);   // правый край x ≈ −1.36
  float b = slab(p, vec3(0.075, 0.0, 0.0), vec3(0.825, 0.12, 0.45), -0.2);   // x −0.75…0.9, уклон к стене
  float wall = slab(p, vec3(1.25, 0.05, 0.0), vec3(0.1, 0.32, 0.45), 0.0);   // x 1.15…1.35; люк 0.9…1.15
  // стена срастается с плитой с половинным k: заращённый люк не вздувает всю плиту горбом
  float top = opSmoothUnion(opSmoothUnion(a, b, k), wall, 0.5 * k);
  float c = chute(p, vec3(0.85, -0.85, 0.0), vec3(3.0, -1.4, 0.0), 4, 0.42, K, 0.8);
  return min(top, c);
}
