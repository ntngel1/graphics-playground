// Уровень 2 «Скручивание»: жёлоб из четырёх секций, каждая повёрнута вокруг оси жёлоба.
// Ручка B закручивает пространство вдоль оси — при верном значении секции встают в один ряд.
float level2(vec3 p, vec2 knob) {
  float K = (knob.y - 0.5) * 0.8;
  return chute(p, vec3(-2.3, 0.9, 0.0), vec3(2.3, -0.5, 0.0), 4, 0.42, K, 0.24);
}
