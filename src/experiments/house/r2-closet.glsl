// Комната 2 — «больше, чем снаружи». Прихожая (x ≈ 30) с кладовкой-будкой у дальней стены.
// Дверь кладовки — портал 2 в высокий зал (x ≈ 60, зал — тупик). Настоящее нутро кладовки маленькое,
// и в его задней стене — выход (портал 4). Попасть в нутро можно только не через дверь: прорезав стенку
// будки снаружи. Изнутри будки её дверь смотрит в прихожую (портал односторонний — с лицевой стороны).

vec2 landing(vec3 p, out vec2 fixedPart) {
  vec3 q = p - vec3(30.0, 0.0, 0.0);
  float space = sdBox(q - vec3(0.0, 1.35, 0.0), vec3(3.0, 1.35, 3.0));
  space = min(space, sdBox(q - vec3(-3.0, 1.05, 0.0), vec3(0.9, 1.05, 0.5)));  // вход (портал 1)
  space = min(space, sdBox(q - vec3(3.1, 1.05, 0.0), vec3(0.8, 1.05, 0.45)));  // выход из нутра будки (портал 4)
  float shell = sdBox(q - vec3(0.0, 1.35, 0.0), vec3(4.0, 2.35, 4.0));
  vec2 d = vec2(max(-space, shell), M_SHELL);
  // будка-кладовка 1.4 × 2.3 × 1.4 у стены x = 3; стенки 0.1; дверной проём в лицевой стенке
  // будка и её нутро уходят в толщу стены (до 3.5/3.8): иначе грани вычитания стоят в проходе к заднему
  // выходу и дают физике «стенку-фантом»; задней стенки у будки нет — сзади стена прихожей с проёмом
  float booth = sdBox(q - vec3(2.55, 1.15, 0.0), vec3(0.95, 1.15, 0.7));
  booth = max(booth, -sdBox(q - vec3(2.75, 1.1, 0.0), vec3(1.05, 1.1, 0.6)));
  // вычитаемый проём глубокий (±0.8): тонкий дал бы физике «стенку-фантом» в самом проёме
  booth = max(booth, -sdBox(q - vec3(1.6, 1.0, 0.0), vec3(0.8, 1.0, 0.45)));
  d = U(d, vec2(booth, M_WOOD));
  // обстановка прихожей
  d = U(d, B(q, vec3(-1.0, 0.004, 0.2), vec3(1.2, 0.004, 0.8), M_FABRIC)); // коврик
  vec3 tq = q - vec3(-1.2, 0.0, -2.5);
  d = U(d, B(tq, vec3(0.0, 0.4, 0.0), vec3(0.45, 0.4, 0.25), M_WOOD)); // тумба
  d = U(d, B(tq, vec3(0.0, 0.95, 0.0), vec3(0.05, 0.15, 0.05), M_BRASS));
  d = U(d, vec2(max(ngonR(tq.xz, 6.0) - 0.14, abs(tq.y - 1.15) - 0.1), M_LAMP));
  d = U(d, picture(vec3(q.x + 0.5, q.y - 1.55, q.z - 2.97) * vec3(-1.0, 1.0, -1.0), vec2(0.5, 0.35)));
  // вешалка
  vec3 hq = q - vec3(-2.6, 0.0, 2.5);
  d = U(d, vec2(sdBox(hq - vec3(0.0, 0.9, 0.0), vec3(0.03, 0.9, 0.03)), M_WOOD));
  d = U(d, vec2(sdBox(hq - vec3(0.0, 1.75, 0.0), vec3(0.25, 0.02, 0.02)), M_WOOD));
  d = U(d, hangLamp(q - vec3(-0.5, 2.7, 0.0)));
  // в нутре будки: лампочка и полка (видно, когда прорежешь стенку)
  d = U(d, B(q, vec3(2.3, 1.5, -0.52), vec3(0.5, 0.02, 0.08), M_WOOD)); // полка на боковой стенке
  d = U(d, vec2(length(q - vec3(2.6, 2.15, 0.0)) - 0.06, M_LAMP));

  // не режется: рама двери будки и зелёные рамы проходов
  fixedPart = frameX(q - vec3(1.58, 0.0, 0.0));
  vec3 e = q - vec3(-2.98, 0.0, 0.0);
  fixedPart = U(fixedPart, frameX(e));
  return d;
}

// Зал (x ≈ 60): 10 × 7 × 14, стеллажи до потолка, люстра, высокие окна-панели. Тупик.
vec2 hall(vec3 p, out vec2 fixedPart) {
  vec3 q = p - vec3(60.0, 0.0, 0.0);
  float space = sdBox(q - vec3(0.0, 3.5, 7.0), vec3(5.0, 3.5, 7.0));
  space = min(space, sdBox(q - vec3(0.0, 1.05, -0.2), vec3(0.5, 1.05, 0.9))); // вход (портал 3)
  float shell = sdBox(q - vec3(0.0, 3.5, 7.0), vec3(6.0, 4.5, 8.0));
  vec2 d = vec2(max(-space, shell), M_SHELL);
  // стеллажи вдоль боковых стен (повтор по z)
  float zr = q.z - 2.0 * clamp(round((q.z - 1.0) / 2.0), 0.0, 6.0) - 1.0;
  d = U(d, bookshelf(vec3(zr, q.y, abs(q.x) - 4.8) * vec3(1.0, 1.0, -1.0), 5.0));
  // длинный стол со стульями, ковёр
  d = U(d, table((q - vec3(0.0, 0.0, 7.0)) * vec3(1.0, 1.0, 0.5)));
  for (int i = 0; i < 3; i++) {
    float z = 5.5 + float(i) * 1.5;
    vec3 c1 = q - vec3(0.9, 0.0, z);
    c1.xz = rot2(1.5708) * c1.xz;
    d = U(d, chair(c1));
    vec3 c2 = q - vec3(-0.9, 0.0, z);
    c2.xz = rot2(-1.5708) * c2.xz;
    d = U(d, chair(c2));
  }
  d = U(d, B(q, vec3(0.0, 0.004, 7.0), vec3(2.0, 0.004, 4.0), M_FABRIC));
  // высокие окна на дальней стене (светлые панели) и часы
  vec3 w = vec3(abs(q.x) - 2.2, q.y - 3.8, q.z - 13.97);
  d = U(d, vec2(sdBox(w, vec3(0.7, 2.2, 0.03)), M_PICT));
  d = U(d, vec2(max(sdBox(w, vec3(0.78, 2.28, 0.05)), -sdBox(w, vec3(0.7, 2.2, 0.1))), M_WOOD));
  // люстра
  vec3 lq = q - vec3(0.0, 5.6, 7.0);
  d = U(d, vec2(max(abs(ngonR(lq.xz, 8.0) - 0.7) - 0.03, abs(lq.y) - 0.03), M_BRASS));
  d = U(d, vec2(length(lq.xz) - 0.015, M_BRASS));
  vec3 cq = vec3(lq.x, lq.y - 0.1, lq.z);
  float a = atan(cq.z, cq.x), s = 6.2831853 / 8.0;
  a = mod(a + 0.5 * s, s) - 0.5 * s;
  vec2 rr = length(cq.xz) * vec2(cos(a), sin(a));
  d = U(d, vec2(length(vec3(rr.x - 0.7, cq.y, rr.y)) - 0.06, M_LAMP));
  // записка у входа
  d = U(d, note(vec3(q.x - 1.2, q.y - 1.5, q.z - 0.02)));
  fixedPart = frameZ(q - vec3(0.0, 0.0, 0.02));
  return d;
}
