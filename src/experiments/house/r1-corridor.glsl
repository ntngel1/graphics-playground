// Комната 1 — бесконечный коридор. Ячейка длиной CP повторяется по z без конца (область |x| < 2).
// На границе ячеек — перегородка толщиной 1 м с железной дверью; на задней стороне каждой двери —
// деревянный засов. Из ячейки виден только засов задней двери (засов передней — по ту сторону).
// Правка в коридоре хранится в координатах ячейки (см. world.glsl) → перерубленный засов исчезает у всех дверей.
// Выход — проём в стене x < 0 ячейки 2 (z = 9, портал 0), единственное неповторяющееся место.

const float CP = 5.0;
uniform float uDoorOpen; // 0..1: двери распахиваются, когда засов перерублен
uniform bool uBarCut;    // засов перерублен — убираем его целиком (обрубки внутри среза давали бы «фантомы» физике)

vec2 corridor(vec3 p, out vec2 fixedPart) {
  float zc = p.z - CP * round(p.z / CP);
  vec3 q = vec3(p.x, p.y, zc);
  // пустота: труба коридора, без зоны перегородок, + проёмы дверей и выхода
  float tube = box2(q.xy - vec2(0.0, 1.35), vec2(1.3, 1.35));
  float space = max(tube, abs(zc) - 2.0);
  // проёмы глубоко заходят в ячейки: объединение пустот через min на тонком стыке даёт «стенку-фантом»
  // (заниженное расстояние) — рендер это терпит, а физика упирается
  float hole = sdBox(vec3(q.x, q.y - 1.05, abs(zc) - 2.5), vec3(0.5, 1.05, 1.3));
  space = min(space, max(hole, tube));
  space = min(space, sdBox(p - vec3(-1.0, 1.05, 9.0), vec3(0.95, 1.05, 0.5))); // выход (неповторяющийся)
  float shell = max(abs(p.x) - 2.3, max(-p.y - 1.0, p.y - 3.7)); // стены 1 м: проём их не пробивает
  vec2 d = vec2(max(-space, shell), M_SHELL);
  // засов на задней (−z) перегородке ячейки, выступает внутрь ячейки
  if (!uBarCut) d = U(d, B(q, vec3(0.0, 1.05, -1.93), vec3(0.75, 0.08, 0.07), M_WOOD));
  else d = U(d, B(vec3(abs(q.x), q.y, q.z), vec3(0.45, 0.06, -1.6), vec3(0.3, 0.06, 0.07), M_WOOD)); // половинки на полу
  // обстановка ячейки: батарея, картина, стул, лампа
  d = U(d, radiator(q - vec3(1.22, 0.0, -0.6)));
  d = U(d, picture(vec3(q.z - 0.4, q.y - 1.55, q.x + 1.28), vec2(0.32, 0.24)));
  vec3 cq = q - vec3(0.85, 0.0, 1.1);
  cq.xz = rot2(2.4) * cq.xz;
  d = U(d, chair(cq));
  d = U(d, hangLamp(q - vec3(0.0, 2.7, 0.0)));

  // не режется: железные двери в проёмах (на границе ячейки — общие для обеих половин) и скобы засова
  float dz = zc >= 0.0 ? zc - 2.5 : zc + 2.5;
  fixedPart = doorSlab(vec3(q.x, q.y, dz), uDoorOpen * 1.75, M_IRON, true);
  fixedPart = U(fixedPart, B(vec3(abs(q.x), q.y, q.z), vec3(0.66, 1.05, -1.93), vec3(0.04, 0.12, 0.09), M_IRON));
  // зелёная рама выхода
  vec3 e = p - vec3(-1.32, 0.0, 9.0);
  fixedPart = U(fixedPart, frameX(e));
  return d;
}

// лампа текущей ячейки (для освещения)
vec3 corridorLamp(vec3 p) { return vec3(0.0, 2.1, CP * round(p.z / CP)); }
